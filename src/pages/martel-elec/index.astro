---
// ─────────────────────────────────────────────────────────────
//  MAQUETTE proposée à Martel Électricité (prospect).
//  Page non référencée (noindex, hors sitemap), avec un bandeau
//  qui indique clairement qu'il s'agit d'un aperçu réalisé par DOLSTA.
//  Numéro de téléphone volontairement masqué (seuls les 3 premiers chiffres),
//  email masqué aussi, pas de SIRET : les vraies coordonnées seront ajoutées à la mise en ligne.
// ─────────────────────────────────────────────────────────────
import '@fontsource/outfit/latin-300.css';
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-700.css';
import MartelLogo from '../../components/martel/Logo.astro';

const proposition = '/proposition/martel-elec';
const facebook = 'https://www.facebook.com/p/Martel-%C3%89lec-61551018905487/';

const services = [
  { title: 'Installation neuf & rénovation', items: ['Maisons individuelles', 'Appartements', 'Locaux professionnels'], icon: 'M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6' },
  { title: 'Tableaux électriques', items: ['Remplacement', 'Mise aux normes NF C 15-100', 'Ajout de protections'], icon: 'M4 3h16v18H4zM8 7v4M12 7v4M16 7v4M8 15h8' },
  { title: 'Dépannage', items: ['Recherche de panne', 'Intervention rapide', 'Remise en service'], icon: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z' },
  { title: 'Éclairage', items: ['Intérieur et extérieur', 'Éclairage LED', 'Conseils et optimisation'], icon: 'M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V16h8v-1.3A7 7 0 0 0 12 2z' },
  { title: 'Prises & chauffage', items: ['Ajout et remplacement de prises', 'Prises renforcées (four, plaque)', 'Radiateurs électriques'], icon: 'M12 22v-5M9 8V2M15 8V2M6 8h12v4a6 6 0 0 1-12 0z' },
  { title: 'Domotique & connecté', items: ['Appareillages connectés', 'Pose de VMC', 'Motorisation de portail'], icon: 'M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M2 9a15 15 0 0 1 20 0M12 20h.01' },
];
const reasons = [
  { title: 'Devis gratuit', text: 'Clair et sans engagement, établi après avoir vu votre installation.', icon: 'M9 12h6M9 16h6M9 8h2M6 3h9l4 4v14H6z' },
  { title: 'Réactif', text: 'Un seul interlocuteur, joignable directement, qui se déplace rapidement.', icon: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
  { title: 'Propre et soigné', text: 'Un chantier rangé et une installation testée avant de partir.', icon: 'M20 6 9 17l-5-5' },
  { title: 'Aux normes', text: 'Une installation conforme et du matériel de marques reconnues.', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' },
];
const steps = [
  { title: 'Vous me contactez', text: 'Par téléphone ou via le formulaire, en expliquant votre besoin ou votre panne.' },
  { title: 'Devis gratuit', text: 'Je viens voir votre installation et je vous remets un devis clair, sans engagement.' },
  { title: 'Intervention soignée', text: 'Travaux réalisés proprement, installation testée avant de partir.' },
];
const reviews = [
  { text: 'Très bon travail, est venu me dépanner rapidement. Je recommande !', name: 'Victor D.', date: 'octobre 2026' },
  { text: 'Je recommande vivement M. Martel. Installation de radiateurs électriques chez moi. Très bon travail, propre et soigné. Très professionnel.', name: 'Patricia D.', date: 'mai 2025' },
  { text: 'Artisan très sérieux. Bon travail, propre et rapide. À recommander sans hésitation.', name: 'Marie-Paule C.', date: 'juillet 2025' },
];
const faq = [
  { q: 'Le devis est-il payant ?', a: 'Non. Le devis est gratuit et sans engagement : je viens voir votre installation, puis je vous explique ce qu’il faut faire et combien ça coûte.' },
  { q: 'Dans quelles communes intervenez-vous ?', a: 'À Saint-Augustin, Aire-sur-la-Lys, Isbergues et dans les communes voisines du Pas-de-Calais. Votre commune n’est pas listée ? Contactez-moi.' },
  { q: 'Travaillez-vous pour les professionnels ?', a: 'Oui : commerces, bureaux et locaux professionnels, en plus des maisons et appartements.' },
  { q: 'Comment savoir si mon tableau est encore aux normes ?', a: 'Échauffement, disjoncteurs qui sautent, installation ancienne ou vente en vue : je viens vérifier votre tableau et vous explique simplement ce qu’il faut faire.' },
];
const ticker = ['Disponible 7j/7', 'Devis gratuit', 'Normes NF C 15-100', 'Saint-Augustin', 'Aire-sur-la-Lys', 'Isbergues', 'Neuf & rénovation'];
const brands = ['Schneider Electric', 'Legrand', 'Hager', 'Somfy', 'FAAC', 'Thermor'];
const bolt = 'M13 2 4 14h7l-1 8 9-12h-7l1-8z';
const arrow = 'M5 12h14M13 6l6 6-6 6';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Martel Électricité — Électricien à Aire-sur-la-Lys et Isbergues (maquette)</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Maquette de site réalisée par DOLSTA pour Martel Électricité." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Bandeau : aperçu réalisé par DOLSTA -->
    <div class="demo">
      <span><strong>Aperçu</strong> · Maquette réalisée par DOLSTA pour Martel Électricité. Ce site n'est pas encore en ligne.</span>
      <a href={proposition}>Voir la proposition →</a>
    </div>

    <div class="me">
      <!-- Header -->
      <header class="hdr">
        <div class="wrap hdr-in">
          <nav aria-label="Navigation principale" class="hdr-nav">
            <a href="#services">Prestations</a>
            <a href="#apropos">À propos</a>
            <a href="#avis">Avis</a>
            <a href="#faq">Questions</a>
          </nav>
          <a href="#top" class="hdr-logo" aria-label="Martel Électricité, accueil">
            <MartelLogo class="logo-svg" />
          </a>
          <div class="hdr-right">
            <a href="#contact" class="btn btn-yellow btn-sm">Devis gratuit</a>
          </div>
        </div>
      </header>

      <!-- Hero -->
      <section id="top" class="hero-section">
        <div class="wrap hero">
          <div class="hero-text">
            <p class="kicker"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Électricien à Saint-Augustin (62)</p>
            <h1 class="h1"><span class="w-600">Votre projet</span> <span class="w-300">électrique,</span> <span class="w-600 yellow">notre métier.</span></h1>
            <p class="lead">Installation, mise aux normes, tableau électrique, dépannage et domotique, à Aire-sur-la-Lys, Isbergues et dans les communes voisines.</p>
            <div class="hero-ctas">
              <a href="#contact" class="btn btn-yellow">Demander un devis gratuit <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg></a>
              <a href="#services" class="link-light">Nos prestations <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg></a>
            </div>
          </div>
          <div class="hero-media">
            <img src="/martel-elec/img/tableau-hero.webp" alt="Tableau électrique câblé par Martel Électricité" width="945" height="1251" />
            <div class="rating">
              <span class="rating-n">5,0</span>
              <span class="rating-t"><span class="stars" aria-label="5 étoiles sur 5">★★★★★</span>7 avis Google</span>
            </div>
          </div>
        </div>
      </section>

      <!-- À propos -->
      <section id="apropos" class="wrap about">
        <p class="label"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>À propos</p>
        <div>
          <p class="statement">Installé à mon compte depuis 2023, je prends le temps d'examiner votre installation, <span class="muted">de vous expliquer les éventuels défauts et de vous proposer des solutions adaptées à votre logement et à votre budget.</span></p>
          <div class="sign">
            <img src="/martel-elec/img/portrait.jpg" alt="" width="281" height="281" />
            <span><strong>Léo Martel</strong><span>Artisan électricien · Particuliers et professionnels</span></span>
          </div>
        </div>
      </section>

      <!-- Bandeau défilant -->
      <div class="ticker" role="note" aria-label={ticker.join(' · ')}>
        <div class="ticker-track" aria-hidden="true">
          {[0, 1].map(() => (
            <span class="ticker-group">
              {ticker.map((t) => <span class="ticker-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d={bolt}></path></svg>{t}</span>)}
            </span>
          ))}
        </div>
      </div>

      <!-- Prestations -->
      <section id="services" class="dark">
        <div class="wrap section">
          <div class="head-center">
            <p class="label label-yellow"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Mes prestations</p>
            <h2 class="h2"><span class="w-300">Toute votre électricité,</span> <span class="w-500">du tableau à la prise.</span></h2>
          </div>
          <div class="svc-grid">
            {services.map((s, i) => (
              <article class="svc">
                <div class="svc-top">
                  <span class="icon-ring"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon}></path></svg></span>
                  <span class="svc-n">0{i + 1}</span>
                </div>
                <h3 class="svc-t">{s.title}</h3>
                <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
              </article>
            ))}
          </div>
          <div class="center"><a href="#contact" class="btn btn-yellow">Parler de votre projet</a></div>
        </div>
      </section>

      <!-- Pourquoi -->
      <section class="wrap section">
        <div class="head-center">
          <p class="label"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Pourquoi Martel Électricité</p>
          <h2 class="h2"><span class="w-300">Un artisan local</span> <span class="w-500">qui prend le temps.</span></h2>
        </div>
        <div class="why-grid">
          {reasons.map((r) => (
            <div class="why">
              <span class="icon-ring icon-ring-dark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={r.icon}></path></svg></span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Bandeau tableau -->
      <section class="wrap">
        <div class="band">
          <div>
            <h2 class="band-t">Votre tableau électrique est-il encore aux normes ?</h2>
            <p>Échauffement, disjoncteurs qui ne protègent plus, installation non conforme en cas de vente ou d'assurance : je viens vérifier et je vous explique simplement ce qu'il faut faire.</p>
          </div>
          <a href="#contact" class="btn btn-dark">Faire vérifier mon tableau</a>
        </div>
      </section>

      <!-- Étapes -->
      <section class="wrap section">
        <div class="head-center">
          <p class="label"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Comment ça se passe</p>
          <h2 class="h2"><span class="w-300">Simple, rapide</span> <span class="w-500">et sans surprise.</span></h2>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="step-n">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Avis -->
      <section id="avis" class="dark">
        <div class="wrap section">
          <div class="head-split">
            <div>
              <p class="label label-yellow"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Avis clients</p>
              <h2 class="h2"><span class="w-300">Ils recommandent</span> <span class="w-500">Martel Électricité.</span></h2>
            </div>
            <p class="score"><span class="score-n">5,0</span><span><span class="stars" aria-label="5 étoiles sur 5">★★★★★</span><br />7 avis Google</span></p>
          </div>
          <div class="rev-grid">
            {reviews.map((v) => (
              <blockquote class="rev">
                <svg class="quote" width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.6 6C6.5 7.4 4.5 10 4.5 13.6V18h5.3v-5.3H7.2c0-2 1.2-3.6 3.2-4.6L9.6 6zm9.4 0c-3.1 1.4-5.1 4-5.1 7.6V18h5.3v-5.3h-2.6c0-2 1.2-3.6 3.2-4.6L19 6z"></path></svg>
                <p>{v.text}</p>
                <footer><strong>{v.name}</strong> · {v.date}</footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>

      <!-- Zone + marques -->
      <section class="wrap section zone">
        <div>
          <p class="label"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Zone d'intervention</p>
          <h2 class="h2"><span class="w-300">Aire-sur-la-Lys,</span> <span class="w-500">Isbergues et environs.</span></h2>
          <p class="body">Basé dans le Pas-de-Calais, je me déplace chez les particuliers et les professionnels du secteur.</p>
          <ul class="towns">{['Saint-Augustin', 'Aire-sur-la-Lys', 'Isbergues', 'et environs'].map((t) => <li>{t}</li>)}</ul>
        </div>
        <div>
          <p class="brands-t">Matériel de marques reconnues</p>
          <ul class="brands">{brands.map((b) => <li>{b}</li>)}</ul>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="wrap section faq-wrap">
        <div>
          <p class="label"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Questions fréquentes</p>
          <h2 class="h2"><span class="w-300">Vous vous</span> <span class="w-500">posez la question&nbsp;?</span></h2>
          <a href="#contact" class="btn btn-dark faq-btn">Me poser une question</a>
        </div>
        <div class="faq">
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="wrap contact-wrap">
        <div class="contact">
          <div class="contact-info">
            <p class="label label-yellow"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bolt}></path></svg>Contact</p>
            <h2 class="h2"><span class="w-300">Un projet électrique&nbsp;?</span> <span class="w-500 nowrap">Parlons-en.</span></h2>
            <p class="body-light">Devis gratuit et sans engagement, par téléphone, par email ou via le formulaire.</p>
            <dl>
              <div><dt>Téléphone</dt><dd><span class="masked" aria-label="Numéro masqué dans la maquette">07 8<span class="blur" aria-hidden="true">0 00 00 00</span></span></dd></div>
              <div><dt>Email</dt><dd><span class="masked" aria-label="Adresse email masquée dans la maquette">leo<span class="blur" aria-hidden="true">.abcdef@abcde.com</span></span></dd></div>
              <div><dt>Secteur</dt><dd>Saint-Augustin, Aire-sur-la-Lys, Isbergues (62)</dd></div>
              <div><dt>Horaires</dt><dd>7j/7, 24h/24</dd></div>
            </dl>
          </div>
          <form id="me-form" class="form">
            <label>Nom<input type="text" placeholder="Votre nom" /></label>
            <label>Téléphone<input type="tel" placeholder="06 00 00 00 00" /></label>
            <label>Commune<input type="text" placeholder="Ex. Aire-sur-la-Lys" /></label>
            <label>Type de besoin<select><option>Dépannage</option><option>Tableau / mise aux normes</option><option>Installation neuve ou rénovation</option><option>Éclairage, prises, chauffage</option><option>Domotique, VMC, portail</option><option>Autre</option></select></label>
            <label class="full">Votre message<textarea rows="4" placeholder="Décrivez votre projet ou votre panne…"></textarea></label>
            <button type="submit" class="btn btn-yellow full">Envoyer ma demande</button>
            <p id="me-form-note" role="status" aria-live="polite" class="full note"></p>
          </form>
        </div>
      </section>

      <!-- Footer -->
      <footer class="ftr">
        <div class="ftr-big" aria-hidden="true">Votre projet, notre métier · Votre projet, notre métier ·</div>
        <div class="wrap ftr-in">
          <div class="ftr-brand">
            <MartelLogo class="logo-svg" />
            <p>Artisan électricien à Saint-Augustin, Aire-sur-la-Lys et Isbergues. Neuf et rénovation, particuliers et professionnels.</p>
          </div>
          <div>
            <p class="ftr-t">Prestations</p>
            <ul>{services.slice(0, 4).map((s) => <li><a href="#services">{s.title}</a></li>)}</ul>
          </div>
          <div>
            <p class="ftr-t">Liens</p>
            <ul>
              <li><a href="#apropos">À propos</a></li>
              <li><a href="#avis">Avis clients</a></li>
              <li><a href="#faq">Questions fréquentes</a></li>
              <li><a href={facebook} target="_blank" rel="noopener">Facebook</a></li>
            </ul>
          </div>
          <div>
            <p class="ftr-t">Contact</p>
            <ul>
              <li><span class="masked" aria-label="Numéro masqué dans la maquette">07 8<span class="blur" aria-hidden="true">0 00 00 00</span></span></li>
              <li><span class="masked" aria-label="Adresse email masquée dans la maquette">leo<span class="blur" aria-hidden="true">.abcdef@abcde.com</span></span></li>
              <li>7j/7, 24h/24</li>
            </ul>
          </div>
        </div>
        <div class="wrap ftr-bottom">
          <span>© {new Date().getFullYear()} Martel Électricité</span>
          <span>Mentions légales</span>
        </div>
      </footer>
    </div>

    <!-- Bouton flottant vers la proposition -->
    <a href={`${proposition}#tarifs`} class="float">Ce site vous plaît ? <strong>Voir l'offre</strong></a>

    <script>
      // Maquette : le formulaire n'envoie rien, il explique simplement qu'il sera branché à la mise en ligne.
      const form = document.getElementById('me-form');
      const note = document.getElementById('me-form-note');
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (note) note.textContent = 'Démonstration : ce formulaire sera relié à votre boîte mail lors de la mise en ligne du site.';
      });
    </script>

    <style is:global>
      :root {
        --ink: #121214; --ink-2: #1c1c20; --line-dark: #2c2c32;
        --yellow: #f5c518; --yellow-2: #ffd84d; --gold: #866500;
        --cream: #f7f5f0; --line: #e4dfd3; --muted: #5a5a62; --muted-dark: #b8b8c0;
        --display: Outfit, system-ui, sans-serif; --text: 'DM Sans', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--cream); }
      .me { font-family: var(--text); color: var(--ink); background: var(--cream); font-size: 16px; line-height: 1.6; }
      .me a { color: inherit; }
      .wrap { max-width: 1240px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
      .section { padding-top: clamp(72px, 9vw, 112px); padding-bottom: clamp(72px, 9vw, 112px); }
      .w-300 { font-weight: 300; } .w-500 { font-weight: 500; } .w-600 { font-weight: 600; }
      .yellow { color: var(--yellow); }
      .muted { color: var(--muted); }
      .center { text-align: center; margin-top: 48px; }

      /* Typo */
      .h1 { margin: 0; font-family: var(--display); font-size: clamp(40px, 6vw, 72px); line-height: 1.02; letter-spacing: -0.03em; }
      .h1 > span { display: block; }
      .h2 { margin: 0; font-family: var(--display); font-size: clamp(32px, 4.2vw, 52px); line-height: 1.08; letter-spacing: -0.025em; }
      .label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; font-size: 14px; font-weight: 500; color: var(--gold); }
      .label-yellow { color: var(--yellow); }
      .kicker { display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); color: #e6e6ea; font-size: 14px; }
      .kicker svg { color: var(--yellow); }
      .lead { margin: 0; font-size: 18px; color: var(--muted-dark); max-width: 520px; }
      .body { margin: 20px 0 0; font-size: 17px; color: var(--muted); max-width: 520px; }
      .body-light { margin: 20px 0 0; font-size: 17px; color: var(--muted-dark); }

      /* Boutons */
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border-radius: 999px; font-family: var(--text); font-weight: 500; font-size: 16px; text-decoration: none; border: 0; cursor: pointer; transition: background .2s, transform .2s; }
      .btn:hover { transform: translateY(-1px); }
      .btn-sm { min-height: 44px; padding: 0 20px; font-size: 15px; }
      .me .btn-yellow { background: var(--yellow); color: var(--ink); }
      .me .btn-yellow:hover { background: var(--yellow-2); }
      .me .btn-dark { background: var(--ink); color: #fff; }
      .me .btn-dark:hover { background: #2a2a30; }
      .me .link-light { display: inline-flex; align-items: center; gap: 8px; color: #fff; text-decoration: none; font-weight: 500; }
      .me .link-light:hover { color: var(--yellow); }

      /* Header */
      .hdr { background: var(--ink); border-bottom: 1px solid var(--line-dark); }
      .hdr-in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding-top: 12px; padding-bottom: 12px; }
      .hdr-nav { display: flex; gap: 28px; font-size: 15px; font-weight: 500; }
      .me .hdr-nav a { text-decoration: none; color: #e6e6ea; }
      .me .hdr-nav a:hover { color: var(--yellow); }
      .hdr-logo { display: block; line-height: 0; }
      .logo-svg { display: block; height: 60px; width: auto; aspect-ratio: 913 / 395; }
      .ftr-brand .logo-svg { height: 72px; }
      .hdr-right { display: flex; justify-content: flex-end; }

      /* Hero */
      .hero-section { background: var(--ink); color: #fff; }
      .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 48px; align-items: center; padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(64px, 8vw, 104px); }
      .hero-text { display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
      .hero-ctas { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; }
      .hero-media { position: relative; }
      .hero-media img { display: block; width: 100%; height: clamp(320px, 42vw, 540px); object-fit: cover; border-radius: 24px; }
      .rating { position: absolute; left: -20px; bottom: 28px; display: flex; gap: 12px; align-items: center; padding: 14px 20px; background: #fff; color: var(--ink); border-radius: 18px; box-shadow: 0 18px 40px rgba(0,0,0,.35); }
      .rating-n { font-family: var(--display); font-weight: 600; font-size: 32px; line-height: 1; }
      .rating-t { display: flex; flex-direction: column; font-size: 13px; color: var(--muted); }
      .stars { color: #b08500; letter-spacing: 2px; font-size: 15px; }

      /* À propos */
      .about .label { margin-top: 10px; }
      .about { display: grid; grid-template-columns: 220px minmax(0, 1fr); align-items: start; gap: 32px; padding-top: clamp(72px, 9vw, 112px); padding-bottom: clamp(56px, 7vw, 88px); }
      .statement { margin: 0; font-family: var(--display); font-weight: 400; font-size: clamp(24px, 3vw, 38px); line-height: 1.25; letter-spacing: -0.015em; }
      .sign { display: flex; align-items: center; gap: 14px; margin-top: 32px; }
      .sign img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
      .sign span { display: flex; flex-direction: column; font-size: 14px; color: var(--muted); }
      .sign strong { font-size: 16px; color: var(--ink); font-weight: 500; }

      /* Bandeau défilant */
      .ticker { overflow: hidden; background: var(--yellow); color: var(--ink); padding: 16px 0; }
      .ticker-track { display: flex; width: max-content; animation: ticker 40s linear infinite; }
      .ticker-group { display: flex; }
      .ticker-item { display: inline-flex; align-items: center; gap: 10px; padding: 0 28px; font-family: var(--display); font-weight: 500; font-size: 18px; white-space: nowrap; }
      @keyframes ticker { to { transform: translateX(-50%); } }

      /* Sections sombres */
      .dark { background: var(--ink); color: #fff; }
      .head-center { text-align: center; max-width: 760px; margin: 0 auto 56px; }
      .head-split { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 48px; }

      /* Prestations */
      .svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
      .svc { padding: 28px; border: 1px solid var(--line-dark); border-radius: 24px; background: var(--ink-2); transition: border-color .2s; }
      .svc:hover { border-color: var(--yellow); }
      .svc-top { display: flex; justify-content: space-between; align-items: center; }
      .svc-n { font-family: var(--display); font-size: 14px; color: #8a8a94; }
      .svc-t { margin: 24px 0 12px; font-family: var(--display); font-weight: 500; font-size: 22px; letter-spacing: -0.01em; }
      .svc ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; color: var(--muted-dark); font-size: 15px; }
      .icon-ring { display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 50%; border: 1px solid #3a3a42; color: var(--yellow); }
      .icon-ring-dark { border-color: var(--line); color: var(--ink); background: #fff; }

      /* Pourquoi */
      .why-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: 24px; background: #fff; }
      .why { padding: 32px 28px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .why + .why { border-left: 1px solid var(--line); }
      .why h3 { margin: 8px 0 0; font-family: var(--display); font-weight: 500; font-size: 20px; }
      .why p { margin: 0; color: var(--muted); font-size: 15px; }

      /* Bandeau tableau */
      .band { display: flex; flex-wrap: wrap; gap: 28px; align-items: center; justify-content: space-between; padding: clamp(32px, 5vw, 56px); border-radius: 32px; background: var(--yellow); }
      .band > div { flex: 1 1 480px; min-width: 0; }
      .band-t { margin: 0 0 10px; font-family: var(--display); font-weight: 500; font-size: clamp(26px, 3vw, 36px); line-height: 1.12; letter-spacing: -0.02em; }
      .band p { margin: 0; max-width: 680px; }

      /* Étapes */
      .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; text-align: center; }
      .step-n { display: block; font-family: var(--display); font-weight: 300; font-size: clamp(64px, 8vw, 96px); line-height: 1; color: var(--ink); letter-spacing: -0.04em; }
      .steps h3 { margin: 16px 0 8px; font-family: var(--display); font-weight: 500; font-size: 20px; }
      .steps p { margin: 0 auto; max-width: 300px; color: var(--muted); font-size: 15px; }

      /* Avis */
      .score { display: flex; align-items: center; gap: 14px; margin: 0; color: var(--muted-dark); font-size: 14px; }
      .score .stars { color: var(--yellow); }
      .score-n { font-family: var(--display); font-weight: 300; font-size: 56px; line-height: 1; color: #fff; }
      .rev-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
      .rev { margin: 0; padding: 32px; border-radius: 24px; background: var(--ink-2); border: 1px solid var(--line-dark); display: flex; flex-direction: column; gap: 18px; }
      .quote { color: var(--yellow); }
      .rev p { margin: 0; flex-grow: 1; font-family: var(--display); font-weight: 300; font-size: 19px; line-height: 1.45; color: #ededf0; }
      .rev footer { font-size: 14px; color: var(--muted-dark); }
      .rev footer strong { color: #fff; font-weight: 500; }

      /* Zone */
      .zone { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: end; }
      .towns { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
      .towns li { padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font-size: 15px; }
      .brands-t { margin: 0 0 14px; font-size: 14px; color: var(--muted); }
      .brands { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
      .brands li { display: flex; align-items: center; justify-content: center; min-height: 88px; padding: 12px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); font-family: var(--display); font-weight: 500; font-size: 17px; color: #3a3a42; text-align: center; background: #fff; }

      /* FAQ */
      .faq-wrap { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; padding-top: 0; }
      .faq-btn { margin-top: 32px; }
      .faq details { border-bottom: 1px solid var(--line); }
      .faq details:first-child { border-top: 1px solid var(--line); }
      .faq summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 0; cursor: pointer; list-style: none; font-family: var(--display); font-weight: 500; font-size: 19px; }
      .faq summary::-webkit-details-marker { display: none; }
      .plus { position: relative; flex: none; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line); background: #fff; }
      .plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: var(--ink); transform: translate(-50%, -50%); }
      .plus::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .2s; }
      details[open] .plus::after { transform: translate(-50%, -50%) rotate(0deg); }
      .faq details p { margin: 0 0 22px; max-width: 620px; color: var(--muted); }

      /* Contact */
      .contact { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 48px; padding: clamp(28px, 5vw, 64px); border-radius: 32px; background: var(--ink); color: #fff; }
      .contact dl { margin: 32px 0 0; display: flex; flex-direction: column; gap: 14px; }
      .contact dl div { display: flex; gap: 16px; flex-wrap: wrap; padding-bottom: 14px; border-bottom: 1px solid var(--line-dark); }
      .contact dt { width: 96px; color: var(--muted-dark); font-size: 14px; padding-top: 2px; }
      .contact dd { margin: 0; font-weight: 500; flex: 1; min-width: 160px; }
      .masked, .nowrap { white-space: nowrap; }
      .blur { filter: blur(5px); user-select: none; margin-left: 1px; }
      .form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding: 28px; border-radius: 24px; background: #fff; color: var(--ink); }
      .form label { display: flex; flex-direction: column; gap: 8px; font-size: 14px; font-weight: 500; }
      .form input, .form select, .form textarea { font: inherit; font-weight: 400; font-size: 16px; padding: 13px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--cream); color: var(--ink); }
      .form textarea { resize: vertical; }
      .full { grid-column: 1 / -1; }
      .note { margin: 0; font-size: 14px; color: var(--muted); }

      /* Footer */
      .ftr { background: var(--ink); color: var(--muted-dark); margin-top: clamp(72px, 9vw, 112px); overflow: hidden; }
      .ftr-big { white-space: nowrap; font-family: var(--display); font-weight: 500; font-size: clamp(48px, 9vw, 120px); letter-spacing: -0.03em; line-height: 1; padding: 48px 0 40px; color: transparent; -webkit-text-stroke: 1px #4a4a52; }
      .ftr-in { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 48px; border-bottom: 1px solid var(--line-dark); }
      
      .ftr-brand p { margin: 18px 0 0; font-size: 15px; max-width: 320px; }
      .ftr-t { margin: 0 0 14px; color: #fff; font-family: var(--display); font-weight: 500; font-size: 17px; }
      .ftr ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
      .me .ftr a { text-decoration: none; color: var(--muted-dark); }
      .me .ftr a:hover { color: var(--yellow); }
      .ftr-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 24px; padding-bottom: 28px; font-size: 14px; }

      /* Bandeau + bouton DOLSTA */
      .demo { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; justify-content: center; padding: 10px 16px; background: #4c4cf0; color: #fff; font: 14px/1.4 'DM Sans', system-ui, sans-serif; text-align: center; }
      .demo a { color: #fff; font-weight: 700; text-underline-offset: 3px; }
      .float { position: fixed; right: 16px; bottom: 16px; z-index: 50; display: inline-flex; gap: 6px; align-items: center; min-height: 48px; padding: 0 20px; border-radius: 999px; background: #4c4cf0; color: #fff; text-decoration: none; font: 15px 'DM Sans', system-ui, sans-serif; box-shadow: 0 12px 30px rgba(20,20,60,.35); }
      .float:hover { filter: brightness(.92); }

      :focus-visible { outline: 3px solid #4c4cf0; outline-offset: 3px; }
      @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } .btn { transition: none; } }

      /* Tablette */
      @media (max-width: 1000px) {
        .hdr-nav { display: none; }
        .hdr-in { grid-template-columns: auto 1fr; }
        .hdr-logo { order: -1; }
        .hero { grid-template-columns: 1fr; }
        .rating { left: 16px; }
        .about { grid-template-columns: 1fr; gap: 8px; }
        .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .why:nth-child(3) { border-left: 0; }
        .why:nth-child(n+3) { border-top: 1px solid var(--line); }
        .rev-grid { grid-template-columns: 1fr; }
        .zone, .faq-wrap, .contact { grid-template-columns: 1fr; }
        .ftr-in { grid-template-columns: 1fr 1fr; }
      }
      /* Mobile */
      @media (max-width: 600px) {
        .wrap { padding-left: 16px; padding-right: 16px; }
        .hdr .logo-svg { height: 48px; }
        .hero-ctas .btn { width: 100%; }
        .svc-grid, .why-grid, .steps { grid-template-columns: 1fr; }
        .why + .why { border-left: 0; border-top: 1px solid var(--line); }
        .brands { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .form { grid-template-columns: 1fr; padding: 20px; }
        .contact { border-radius: 24px; padding: 28px 20px; }
        .ftr-in { grid-template-columns: 1fr; }
        .float { left: 16px; right: 16px; justify-content: center; }
      }
    </style>
  </body>
</html>
