---
import Logo from './Logo.astro';
import { nav, navCta, site } from '../data/site';
const links = [...nav, { label: 'Contact', href: navCta.href }, { label: 'Mentions légales', href: '/mentions-legales' }];
---

<footer class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-5 px-5 pt-12 pb-10 text-sm text-muted sm:px-8">
  <Logo as="span" />
  <nav aria-label="Pied de page" class="flex flex-wrap gap-6">
    {links.map((l) => <a href={l.href} class="py-3 text-ink no-underline hover:text-blue">{l.label}</a>)}
  </nav>
  <span>© {site.year} {site.name}</span>
</footer>
