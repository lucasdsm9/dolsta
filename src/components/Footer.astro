---
import Logo from './Logo.astro';
import { nav, navCta, site } from '../data/site';
const links = [...nav, { label: 'Contact', href: navCta.href }, { label: 'Mentions légales', href: '/mentions-legales' }];
---

<footer class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-5 px-5 pt-12 pb-10 text-sm text-muted sm:px-8">
  <div class="flex items-center gap-3">
    <Logo as="span" />
    <span class="flex items-center gap-1.5 text-sm text-muted">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
      {site.region}
    </span>
  </div>
  <nav aria-label="Pied de page" class="flex flex-wrap gap-x-6">
    {links.map((l) => <a href={l.href} class="py-3 text-ink no-underline hover:text-blue">{l.label}</a>)}
  </nav>
  <span>© {site.year} {site.name}</span>
</footer>
