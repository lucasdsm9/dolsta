---
import ProjectVisual from './ProjectVisual.astro';
import { projects } from '../data/site';

// Remplit toujours des rangées complètes de 3 sur grand écran (projets + carte « Votre projet ») :
// s'il reste 2 cases, le 1er projet s'affiche en large ; s'il en reste 1, la carte d'appel prend toute la rangée.
const total = projects.length + 1;
const wideFirst = total % 3 === 2;
const wideCta = total % 3 === 1;
// Capture dans un téléphone : la taille du téléphone vient du ratio de la capture (720×1297),
// pas de l'image elle-même, pour un affichage identique partout (Safari iOS compris).
---

<section id="projets" class="relative z-10 -mt-12 scroll-mt-6 rounded-t-[36px] bg-white shadow-[0_-18px_40px_rgba(232,51,74,0.10)]">
  <div class="mx-auto flex max-w-[1280px] flex-wrap items-end justify-between gap-6 px-5 pt-20 pb-10 sm:px-8">
    <h2 class="max-w-[560px] font-display text-[clamp(34px,4.2vw,56px)] leading-[1.12] font-normal tracking-[-0.01em] text-ink-soft">
      Projets{' '}
      <span class="mx-[0.06em] inline-flex h-[0.95em] w-[0.95em] -rotate-[8deg] items-center justify-center rounded-[0.24em] bg-accent align-middle">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-[58%] w-[58%]"><path d="M12 21s-7.5-4.6-9.6-9.2C1 8.6 3 5 6.6 5c2.1 0 3.5 1.1 4.4 2.5C11.9 6.1 13.3 5 15.4 5 19 5 21 8.6 21.6 11.8 19.5 16.4 12 21 12 21z" fill="#FFFFFF"></path></svg>
      </span>
      {' '}qu'on a construits
    </h2>
    <p class="max-w-[380px] text-[15px] leading-relaxed text-muted">
      Artisans, PME ou grands comptes : on part de vos besoins réels pour livrer des sites qui attirent des clients et
      des outils qui font tourner l'entreprise.
    </p>
  </div>

  <ul class="mx-auto grid max-w-[1280px] grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 px-5 pt-2 pb-20 sm:px-8" aria-label="Projets réalisés">
    {projects.map((p, i) => (
      <li class:list={['group flex flex-col overflow-hidden rounded-[24px] border border-line bg-white transition-shadow duration-300 hover:shadow-[0_20px_40px_rgba(30,30,60,0.10)]', wideFirst && i === 0 && 'lg:col-span-2 lg:flex-row']}>
        <div class:list={['relative aspect-[300/230] overflow-hidden', wideFirst && i === 0 && 'lg:aspect-auto lg:w-[56%] lg:shrink-0']} style={`background:${p.bg}`}>
          {p.screenshot ? (
            <div class="absolute top-[12%] left-1/2 box-content aspect-[720/1297] h-[118%] -translate-x-1/2 -rotate-[5deg] overflow-hidden rounded-[34px] border-[7px] border-ink bg-ink shadow-[0_24px_50px_rgba(120,60,20,0.28)] transition-transform duration-500 group-hover:-translate-y-2 group-hover:-rotate-[3deg]">
              <img
                src={p.screenshot.src}
                alt={p.screenshot.alt}
                width="720"
                height="1297"
                decoding="async"
                class="block h-full w-full rounded-[27px] object-cover object-top"
              />
            </div>
          ) : (
            <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-[1.03]">
              <ProjectVisual visual={p.visual} />
            </div>
          )}
          <span class="absolute top-4 left-4 rounded-full bg-white px-3 py-1.5 text-xs font-medium text-ink">{p.tag}</span>
        </div>
        <div class:list={['flex flex-1 flex-col gap-3 p-6 sm:p-7', wideFirst && i === 0 && 'lg:justify-center lg:p-10']}>
          <h3 class="font-display text-[28px] font-normal text-ink">{p.name}</h3>
          <p class="text-[15px] leading-relaxed text-muted">{p.description}</p>
          {p.url && (
            <a
              href={p.url}
              target="_blank"
              rel="noopener"
              class:list={['mt-auto inline-flex min-h-11 items-center gap-2 self-start pt-2 text-[15px] font-medium text-blue no-underline hover:text-blue-ink', wideFirst && i === 0 && 'lg:mt-2']}
            >
              Voir le site
              <span class="sr-only">{p.name} (nouvel onglet)</span>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>
            </a>
          )}
        </div>
      </li>
    ))}

    <!-- Carte d'appel à l'action : reste toujours en dernier -->
    <li class:list={['relative flex min-h-[360px] flex-col justify-between overflow-hidden rounded-[24px] bg-night p-7 text-white', wideCta && 'md:col-span-2 lg:col-span-3 lg:min-h-[260px]']}>
      <svg aria-hidden="true" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full">
        <defs>
          <filter id="spray-proj" x="-30%" y="-30%" width="160%" height="160%">
            <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" result="noise"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="26"></feDisplacementMap>
          </filter>
        </defs>
        <g filter="url(#spray-proj)">
          <path d="M 250 330 C 280 240, 330 250, 350 200 S 400 140, 440 160" fill="none" stroke="#E8334A" stroke-width="46" stroke-linecap="round"></path>
        </g>
      </svg>
      <p class="relative font-display text-[clamp(28px,3vw,36px)] leading-[1.15]">Votre projet pourrait être le prochain.</p>
      <div class="relative">
        <p class="mb-5 max-w-[300px] text-[15px] leading-relaxed text-[#D6D6DE]">Site vitrine, outil interne ou application : parlons de ce qui vous ferait gagner du temps.</p>
        <a href="#contact" class="inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-6 text-[15px] font-medium text-ink no-underline transition hover:bg-[#F4F4F7]">
          Démarrer un projet
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </li>
  </ul>
</section>
