---
import { process } from '../data/site';
const tones = {
  pink: 'bg-pink-wash text-accent-ink',
  blue: 'bg-lavender text-blue-ink',
};
---

<section id="process" class="mx-auto max-w-[1280px] scroll-mt-6 px-5 py-28 sm:px-8">
  <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
    <h2 class="font-display text-[clamp(34px,4.2vw,56px)] font-normal tracking-[-0.01em] text-ink-soft">Comment on travaille</h2>
    <p class="max-w-[360px] text-[15px] leading-relaxed text-muted">
      Un process simple et transparent, avec des démos régulières pour que vous gardiez la main.
    </p>
  </div>
  <ol class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-5">
    {process.map((step) => (
      <li class="flex flex-col gap-3.5 rounded-[20px] border border-[#ECECF0] p-7">
        <span class:list={['inline-flex h-11 w-11 items-center justify-center rounded-full text-[15px] font-semibold', tones[step.tone]]} aria-hidden="true">{step.num}</span>
        <h3 class="font-display text-2xl font-normal">{step.title}</h3>
        <p class="text-sm leading-relaxed text-muted">{step.text}</p>
      </li>
    ))}
  </ol>
</section>
