# Copie ce fichier en .env et remplis les valeurs (ne jamais committer .env)

# Domaine du site (sans https://)
DOMAIN=dolsta.fr

# ── Envoi des demandes du formulaire via Gmail ────────────────
# SMTP_PASS n'est PAS ton mot de passe Gmail : c'est un « mot de passe d'application »
# de 16 lettres, créé sur https://myaccount.google.com/apppasswords
# (la validation en deux étapes doit être activée sur le compte Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true pour le port 465
SMTP_SECURE=true
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM="DOLSTA <ton.adresse@gmail.com>"

# Adresse qui reçoit les demandes du formulaire
CONTACT_TO=ton.adresse@gmail.com
