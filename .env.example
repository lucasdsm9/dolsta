# Copie ce fichier en .env et remplis les valeurs (ne jamais committer .env)

# Domaine du site (sans https://)
DOMAIN=dolsta.fr

# Serveur d'envoi d'emails (ex. OVH, Gmail, Brevo, Mailjet…)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true si port 465, false si port 587
SMTP_SECURE=false
SMTP_USER=contact@dolsta.fr
SMTP_PASS=change-moi
SMTP_FROM="DOLSTA <contact@dolsta.fr>"

# Adresse qui reçoit les demandes du formulaire
CONTACT_TO=contact@dolsta.fr
